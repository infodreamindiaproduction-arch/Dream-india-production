<article class="product-card" data-category="{{ product.type | downcase | escape }}"><div class="product-image"><a href="{{ product.url }}">{% render 'product-media', product: product %}</a>{% if product.compare_at_price > product.price %}<span class="badge">BEAUTY DEAL</span>{% endif %}{% if product.available and product.has_only_default_variant %}<button class="quick" data-add data-id="{{ product.selected_or_first_available_variant.id }}">ADD TO BAG +</button>{% elsif product.available %}<a class="quick" style="text-align:center" href="{{ product.url }}">CHOOSE YOUR SHADE ↗</a>{% else %}<span class="quick" style="text-align:center">SOLD OUT</span>{% endif %}</div><div class="product-info"><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p>{{ product.type | escape }}</p><div class="price">{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div></article>