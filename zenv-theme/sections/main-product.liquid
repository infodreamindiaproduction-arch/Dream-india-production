<section class="content-page product-detail"><div>{% render 'product-media', product: product, image_class: 'main-image' %}{% for image in product.images offset: 1 %}{{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}{% endfor %}</div><div><div class="eyebrow">ZENV COSMETICS</div><h1>{{ product.title | escape }}</h1><div id="product-price-{{ section.id }}" class="price">{{ product.selected_or_first_available_variant.price | money }}</div>{% form 'product', product %}<label for="variant-{{ section.id }}">Choose your shade / option</label><select id="variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" data-available="{{ variant.available }}" data-price="{{ variant.price | money | escape }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label for="quantity-{{ section.id }}">Quantity</label><input id="quantity-{{ section.id }}" class="quantity" type="number" name="quantity" min="1" value="1"><button id="product-submit-{{ section.id }}" class="button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</button><button id="product-buy-{{ section.id }}" class="button light" type="submit" name="return_to" value="{{ routes.root_url }}checkout" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>BUY NOW</button>{{ form.errors | default_errors }}{% endform %}<div class="rte">{{ product.description }}</div>{% if shop.shipping_policy.body != blank %}<p><a class="text-link" href="{{ shop.shipping_policy.url }}">Shipping policy</a></p>{% endif %}</div></section><script>document.getElementById('variant-{{ section.id }}').addEventListener('change',function(){const option=this.selectedOptions[0];const button=document.getElementById('product-submit-{{ section.id }}');button.disabled=option.dataset.available!=='true';button.textContent=button.disabled?'SOLD OUT':'ADD TO CART';document.getElementById('product-buy-{{ section.id }}').disabled=button.disabled;document.getElementById('product-price-{{ section.id }}').textContent=option.dataset.price;const url=new URL(location);url.searchParams.set('variant',this.value);history.replaceState({},'',url);});</script>{% schema %}{"name":"Product details","settings":[]}{% endschema %}