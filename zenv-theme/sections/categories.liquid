<section class="section"><div class="section-title"><div class="eyebrow">A LITTLE SOMETHING FOR EVERY YOU</div><h2>{{ section.settings.heading | escape }}</h2><p>Your routine. Your favourites. All right here.</p></div><div class="category-grid">{% for block in section.blocks %}<a class="category" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}><div class="category-img">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}{% assign art = 'zenv-product-01.png' %}{% case forloop.index %}{% when 2 %}{% assign art = 'zenv-product-03.png' %}{% when 3 %}{% assign art = 'zenv-product-07.png' %}{% when 4 %}{% assign art = 'zenv-product-09.png' %}{% when 5 %}{% assign art = 'zenv-product-10.png' %}{% when 6 %}{% assign art = 'zenv-product-04.png' %}{% endcase %}<img src="{{ art | asset_url }}" width="200" height="200" loading="lazy" alt="{{ block.settings.title | escape }} concept illustration">{% endif %}</div><strong>{{ block.settings.title | escape }} ↗</strong></a>{% endfor %}</div></section>{% schema %}{"name": "Shop by category", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Find your beauty mood"}], "blocks": [{"type": "category", "name": "Category", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Lips"}, {"type": "image_picker", "id": "image", "label": "Image"}, {"type": "url", "id": "link", "label": "Collection link"}]}], "max_blocks": 8, "presets": [{"name": "Shop by category", "blocks": [{"type": "category", "settings": {"title": "Lips"}}, {"type": "category", "settings": {"title": "Face"}}, {"type": "category", "settings": {"title": "Eyes"}}, {"type": "category", "settings": {"title": "Skin prep"}}, {"type": "category", "settings": {"title": "Brushes & tools"}}, {"type": "category", "settings": {"title": "Value sets"}}]}]}{% endschema %}