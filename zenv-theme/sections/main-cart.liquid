<section class="content-page"><h1>Your beauty bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-item">{% render 'product-media', product: item.product %}<div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3><p>{{ item.variant.title | escape }} · {{ item.final_line_price | money }}</p><label>Quantity <input type="number" min="0" name="updates[]" value="{{ item.quantity }}" aria-label="Quantity for {{ item.title | escape }}"></label><a href="{{ item.url_to_remove }}">Remove</a></div></div>{% endfor %}<p>Subtotal: {{ cart.total_price | money }}</p><p>Shipping and taxes calculated at checkout.</p><button class="button light" name="update" type="submit">UPDATE BAG</button><button class="button" name="checkout" type="submit">CHECKOUT ↗</button></form>{% else %}<p>Your bag is waiting for your next favourite.</p><a class="button" href="{{ routes.all_products_collection_url }}">EXPLORE ZENV</a>{% endif %}</section>{% schema %}{"name":"Shopping bag","settings":[]}{% endschema %}