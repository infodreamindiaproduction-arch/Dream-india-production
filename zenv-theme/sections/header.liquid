<div class="announcement">{{ section.settings.announcement | escape }}</div><header class="header"><div class="header-main"><span class="small-note">A LITTLE BEAUTY. EVERY DAY.</span><button class="icon mobile-toggle" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="main-nav"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button><a class="logo" href="{{ routes.root_url }}" aria-label="Zenv Cosmetics home">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 320 | image_tag: width: 160, alt: shop.name }}{% else %}<b>zenv</b><span>C O S M E T I C S</span>{% endif %}</a><div class="header-actions"><button class="icon" data-search-toggle aria-label="Search products" aria-expanded="false" aria-controls="search-panel"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><button class="icon" data-open-cart aria-label="Open shopping bag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 8V5a3 3 0 0 1 6 0v3"/></svg><span class="cart-count" data-cart-count>{{ cart.item_count }}</span></button></div></div><nav id="main-nav" class="nav" aria-label="Main navigation">{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}{% if link.links != blank %}<details><summary>{{ link.title | escape }}</summary><div class="mega"><div>{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for sub in child.links %}<a href="{{ sub.url }}">{{ sub.title | escape }}</a>{% endfor %}{% endfor %}</div></div></details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}{% endfor %}{% else %}<a href="{{ routes.collections_url }}/new-arrivals">NEW ARRIVALS</a><details><summary>MAKEUP</summary><div class="mega"><div><strong>Lips</strong><a href="{{ routes.collections_url }}/lips">All lip products</a><a href="{{ routes.collections_url }}/lipstick">Lipstick</a><a href="{{ routes.collections_url }}/lip-gloss">Lip gloss &amp; tints</a><a href="{{ routes.collections_url }}/lip-liner">Lip liner</a></div><div><strong>Face</strong><a href="{{ routes.collections_url }}/face">All face products</a><a href="{{ routes.collections_url }}/foundation">Foundation</a><a href="{{ routes.collections_url }}/concealer">Concealer</a><a href="{{ routes.collections_url }}/blush">Blush &amp; highlighter</a></div><div><strong>Eyes</strong><a href="{{ routes.collections_url }}/eyes">All eye products</a><a href="{{ routes.collections_url }}/kajal">Kajal &amp; eyeliner</a><a href="{{ routes.collections_url }}/mascara">Mascara</a><a href="{{ routes.collections_url }}/eyeshadow">Eyeshadow</a></div><div><strong>Your essentials</strong><a href="{{ routes.collections_url }}/brushes">Brushes &amp; tools</a><a href="{{ routes.collections_url }}/skin">Skin prep</a><a href="{{ routes.collections_url }}/bestsellers">Bestsellers</a><a href="{{ routes.collections_url }}/combos">Value sets</a></div></div></details><a href="{{ routes.collections_url }}/lips">LIPS</a><a href="{{ routes.collections_url }}/eyes">EYES</a><a href="{{ routes.collections_url }}/face">FACE</a><a href="{{ routes.collections_url }}/brushes">BRUSHES &amp; TOOLS</a><a href="{{ routes.collections_url }}/combos">COMBOS</a><a class="sale-link" href="{{ routes.collections_url }}/sale">THE BEAUTY EDIT</a>{% endif %}</nav><div id="search-panel" class="search-panel"><form action="{{ routes.search_url }}" method="get" id="search-form"><input type="search" name="q" required placeholder="Find your next favourite…" aria-label="Search products"><input type="hidden" name="type" value="product"><button class="button" type="submit">SEARCH</button></form></div></header>
{% schema %}{"name": "Zenv header", "settings": [{"type": "text", "id": "announcement", "label": "Announcement", "default": "YOUR EVERYDAY BEAUTY, ELEVATED. WELCOME TO ZENV."}, {"type": "image_picker", "id": "logo", "label": "Brand logo"}, {"type": "link_list", "id": "menu", "label": "Navigation menu"}]}{% endschema %}