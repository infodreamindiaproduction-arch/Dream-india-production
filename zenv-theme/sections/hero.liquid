<section class="hero"><div class="hero-copy"><div class="eyebrow">{{ section.settings.eyebrow | escape }}</div><h1>{{ section.settings.heading | escape }}<br><em>{{ section.settings.accent | escape }}</em></h1><p>{{ section.settings.description | escape }}</p><a class="button" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.button | escape }} <span>↗</span></a><div class="hero-footer"><span></span> YOUR BEAUTY. YOUR RULES.</div></div>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: class: 'hero-art', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}{% else %}<img class="hero-art" src="{{ 'hero.svg' | asset_url }}" width="1000" height="1100" alt="Zenv lip colour collection — concept illustration">{% endif %}</section><div class="ticker"><span>MADE FOR YOUR EVERYDAY</span><span>COLOUR WITHOUT LIMITS</span><span>FIND YOUR SIGNATURE SHADE</span><span>A LITTLE ZENV. A LOT OF YOU.</span></div>{% schema %}{"name": "Zenv campaign hero", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE EVERYDAY MUSE COLLECTION"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Your shade."}, {"type": "text", "id": "accent", "label": "Italic heading", "default": "Your kind of beautiful."}, {"type": "textarea", "id": "description", "label": "Description", "default": "Soft textures. Statement shades. Meet the beauty essentials that feel a little more you."}, {"type": "text", "id": "button", "label": "Button text", "default": "FIND YOUR FAVOURITES"}, {"type": "url", "id": "link", "label": "Button link"}, {"type": "image_picker", "id": "image", "label": "Hero campaign image"}], "presets": [{"name": "Zenv campaign hero"}]}{% endschema %}