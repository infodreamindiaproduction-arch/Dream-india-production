<section class="section"><h1 style="font:40px Georgia">Find your favourites</h1><form action="{{ routes.search_url }}" class="filters"><input name="q" type="search" value="{{ search.terms | escape }}" required aria-label="Search products"><input type="hidden" name="type" value="product"><button class="button">SEARCH</button></form>{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 24 %}<div class="products">{% for product in search.results %}{% if product.object_type == 'product' %}{% render 'product-card', product: product %}{% endif %}{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}{% endif %}</section>{% schema %}{"name":"Search results","settings":[]}{% endschema %}