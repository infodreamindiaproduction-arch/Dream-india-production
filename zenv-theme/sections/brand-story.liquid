<section class="brand-story"><div class="story-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}{% else %}<img src="{{ 'hero.svg' | asset_url }}" width="1000" height="1100" alt="The Zenv colour collection, concept art" loading="lazy">{% endif %}</div><div class="story-copy"><div class="eyebrow">A NOTE FROM ZENV</div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="text-link" href="{{ section.settings.link | default: '/pages/about' }}">GET TO KNOW US ↗</a></div></section><div class="perks"><div class="perk"><span>✧</span><strong>COLOUR FOR EVERY MOOD</strong></div><div class="perk"><span>♡</span><strong>BEAUTY THAT FEELS LIKE YOU</strong></div><div class="perk"><span>◈</span><strong>YOUR EVERYDAY ESSENTIALS</strong></div><div class="perk"><span>↗</span><strong>DISCOVER SOMETHING NEW</strong></div></div>{% schema %}{"name": "The Zenv story", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "More than makeup.\nA little more you."}, {"type": "textarea", "id": "description", "label": "Description", "default": "Beauty is personal. A favourite shade, a five-minute ritual, a little moment just for you. Zenv is a space to explore it all \u2014 and find what makes you feel like yourself."}, {"type": "image_picker", "id": "image", "label": "Image"}, {"type": "url", "id": "link", "label": "About page link"}], "presets": [{"name": "The Zenv story"}]}{% endschema %}