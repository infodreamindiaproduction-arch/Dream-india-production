<section class="section"><div class="campaign">{% for block in section.blocks %}<div class="campaign-card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.heading }}{% else %}{% assign art = 'product-' | append: forloop.index | append: '.svg' %}<img src="{{ art | asset_url }}" width="600" height="700" loading="lazy" alt="Zenv concept product">{% endif %}<div class="campaign-copy"><div class="eyebrow">{{ block.settings.eyebrow | escape }}</div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.description | escape }}</p><a class="text-link" href="{{ block.settings.link | default: '/collections/all' }}">SHOP THE EDIT ↗</a></div></div>{% endfor %}</div></section>{% schema %}{"name": "Beauty edits", "blocks": [{"type": "edit", "name": "Beauty edit", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE BEAUTY EDIT"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Find your new favourite."}, {"type": "textarea", "id": "description", "label": "Description"}, {"type": "url", "id": "link", "label": "Link"}, {"type": "image_picker", "id": "image", "label": "Image"}]}], "max_blocks": 2, "presets": [{"name": "Beauty edits", "blocks": [{"type": "edit", "settings": {"eyebrow": "THE LIP WARDROBE", "heading": "A shade for every side of you.", "description": "From barely there to all eyes on you.", "link": "/collections/lips"}}, {"type": "edit", "settings": {"eyebrow": "THE GLOW GUIDE", "heading": "Good skin. Great energy.", "description": "A fresh take on your everyday base.", "link": "/collections/face"}}]}]}{% endschema %}