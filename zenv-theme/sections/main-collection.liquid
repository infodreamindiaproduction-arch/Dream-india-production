<section class="section"><div class="section-title"><div class="eyebrow">THE ZENV BEAUTY SHELF</div><h1 style="font:44px Georgia">{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div></div><form class="filters" method="get"><span>{{ collection.products_count }} products</span><label>Sort by <select name="sort_by" onchange="this.form.submit()">{% assign selected_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == selected_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label></form>{% paginate collection.products by 24 %}<div class="products">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products in this collection yet. Check back soon.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>{% schema %}{"name":"Collection products","settings":[]}{% endschema %}