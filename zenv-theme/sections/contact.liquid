<section class="content-page"><h1>{{ page.title | default: 'Get in touch' | escape }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p role="status">Thank you. Your message has been sent.</p>{% endif %}{{ form.errors | default_errors }}<label for="contact-name">Name</label><input id="contact-name" name="contact[name]" autocomplete="name" required><label for="contact-email">Email</label><input id="contact-email" type="email" name="contact[email]" autocomplete="email" required><label for="contact-body">Message</label><textarea id="contact-body" name="contact[body]" rows="6" required></textarea><button class="button" type="submit">SEND MESSAGE ↗</button>{% endform %}</section>{% schema %}{"name":"Contact form","settings":[]}{% endschema %}